# Front environment variables — local development only.
# Copy this file to `front/.env` and fill in your values, OR just rely on
# `back/.env` (this repo's scripts/set-env.js uses it as a fallback).
# Never commit `.env` files with real values.

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Optional — defaults to `${NEXT_PUBLIC_SUPABASE_URL}/functions/v1`
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://<project_ref>.supabase.co/functions/v1
