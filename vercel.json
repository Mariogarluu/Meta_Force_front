{
  "buildCommand": "npm run build -- --configuration production && npm run compodoc:build",
  "outputDirectory": "dist/credentials/browser",
  "devCommand": "npm run start",
  "installCommand": "npm install",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

